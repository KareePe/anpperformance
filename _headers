# Cloudflare Pages cache headers (same idea as firebase.json).
# Rules must not overlap: Pages merges every matching rule, which would duplicate Cache-Control.
# HTML/XML/TXT keep the Pages default (max-age=0, must-revalidate).
# CSS/JS are cached for a year — bump ?v= in index.html whenever they change.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/web/*
  Cache-Control: public, max-age=2592000

/assets/portfolio/*
  Cache-Control: public, max-age=2592000

/assets/parts/*
  Cache-Control: public, max-age=2592000

/assets/vdo/*
  Cache-Control: public, max-age=2592000

/assets/:file
  Cache-Control: public, max-age=2592000
